{
  "extends": [
    "next/core-web-vitals", 
    "next/typescript",
    "plugin:jsonc/recommended-with-jsonc"
  ],
  "overrides": [
    {
      "files": [
        "*.json",
        "*.json5",
        "*.jsonc"
      ],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "jsonc/array-element-newline": [
          "error",
          "always"
        ],
        "jsonc/array-bracket-newline": [
          "error",
          { "multiline": true, "minItems": 2 }
        ],
        "jsonc/indent": [
          "error",
          2
        ]
      }
    }
  ]
}
